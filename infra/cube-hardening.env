# T-132, the Cube hardening baseline from ADR-003. ONE copy, loaded by both the app
# stack and the conformance stack via `env_file:`.
#
# Duplicating these across compose files would let the conformance stack certify a
# configuration we do not actually run -- the tier would attest to the wrong engine
# setup. Sharing the file makes that drift impossible rather than merely unlikely.
CUBEJS_DEV_MODE=false

# The one that must never be dropped: without it the container boots, /readyz passes,
# and /v1/load throws at QUERY time (T-118). A healthy-looking broken deploy.
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory

CUBEJS_DEFAULT_API_SCOPES=meta,data,sql
CUBEJS_TESSERACT_SQL_PLANNER=true

# Deliberately UNSET, and this file is the record of why:
#   CUBEJS_PG_SQL_PORT     - the Postgres-wire SQL API stays off (one door, §2.2)
#   CUBEJS_CUBESTORE_HOST  - not needed with pre-aggregations off (T-118)
#   CUBEJS_REFRESH_WORKER  - nothing to refresh without pre-aggregations
#   CUBEJS_REDIS_*         - removed in Cube v0.32.0; a stray one now hard-errors
