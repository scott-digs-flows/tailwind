# Single source of version truth. Read by docker-compose AND by CI -- never two places.
# Cube pinned to an exact minor per ADR-003 Version pin: v1.7.x, because both LTS lines
# predate Tesseract-as-default and multi-fact views are why Cube won ADR-003.
CUBE_VERSION=v1.7.18
NODE_VERSION=24.19.0   # Active LTS as of 2026-08. 22.x is maintenance-only; 26.x is Current, not LTS.
POSTGRES_VERSION=16.6
REDIS_VERSION=7.4
NGINX_VERSION=1.27-alpine

# Host ports only. Container-internal ports are unchanged, so service-to-service URLs
# stay standard. Moved to a 7xxx block on 2026-08-13 to coexist with the
# data-warehouse-local stack, which holds 8080, 8123, 5432, 8000, 8181, 9000-9010.
# No CLICKHOUSE_PORT here on purpose: Tailwind does not run its own ClickHouse. It
# joins warehouse-net and talks to the data-warehouse-local instance (Q-01, T-135).
WEB_PORT=7080
API_PORT=7001
CUBE_PORT=7400
POSTGRES_PORT=7432
REDIS_PORT=7379
# Conformance fixture engine. Matches the data-warehouse-local ClickHouse major so the
# tier we certify is the engine we run.
CLICKHOUSE_CI_VERSION=26.7.3.19-alpine
