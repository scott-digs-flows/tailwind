# Single source of version truth. Read by docker-compose AND by CI -- never two places.
# Cube pinned to an exact minor per ADR-003 Version pin: v1.7.x, because both LTS lines
# predate Tesseract-as-default and multi-fact views are why Cube won ADR-003.
CUBE_VERSION=v1.7.18
NODE_VERSION=22.10.0
POSTGRES_VERSION=16.6
REDIS_VERSION=7.4
