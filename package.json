{
  "name": "tailwind",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "up": "docker compose --env-file infra/versions.env -f infra/docker-compose.yml up --build",
    "validate:backlog": "python3 scripts/validate_jira.py"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
