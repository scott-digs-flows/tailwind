# Copy to .env and fill in. .env is gitignored.

# --- Runtime ---
TAILWIND_ENV=dev                  # dev | staging | prod | test
TAILWIND_DEBUG=false
TAILWIND_LOG_LEVEL=INFO
TAILWIND_HOST=127.0.0.1
TAILWIND_PORT=8050

# Flask session secret. Must be a strong random value in staging/prod.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TAILWIND_SECRET_KEY=replace-me

# --- Warehouse ---
TAILWIND_WAREHOUSE_TYPE=stub      # stub | snowflake | bigquery | postgres
# TAILWIND_WAREHOUSE_DSN=snowflake://user:password@account/database/schema?warehouse=W&role=R

# --- AI (Anthropic) ---
TAILWIND_AI_ENABLED=true
TAILWIND_AI_MODEL=claude-opus-4-7
# ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub (idea submission) ---
# TAILWIND_GITHUB_REPO=org/repo
# TAILWIND_GITHUB_TOKEN=ghp_...
