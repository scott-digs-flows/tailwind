{
  "name": "@tailwind/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --test test/*.test.ts",
    "guard:tenancy": "node src/tenancy-guard-cli.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "@tailwind/semantic": "workspace:*",
    "@tailwind/spec": "workspace:*",
    "pg": "^8.13.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "@types/pg": "^8.11.10"
  }
}
